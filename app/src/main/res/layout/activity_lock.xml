<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/lock_title"
        android:textColor="@color/gold"
        android:textSize="30sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="10dp"
        android:text="@string/lock_hint"
        android:textColor="@color/text_dim"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/lock_pin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_input"
        android:gravity="center"
        android:hint="@string/lock_hint"
        android:inputType="numberPassword"
        android:maxLength="12"
        android:padding="14dp"
        android:textColor="@color/text"
        android:textColorHint="@color/text_dim" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_glow_button"
        android:onClick="onUnlock"
        android:text="@string/lock_unlock"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />
</LinearLayout>
