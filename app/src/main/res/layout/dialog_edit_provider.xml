<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/edit_pname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/provider_name_label"
            android:inputType="text"
            android:textColor="@color/text" />

        <EditText
            android:id="@+id/edit_base"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/base_label"
            android:inputType="textUri"
            android:textColor="@color/text" />

        <EditText
            android:id="@+id/edit_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/model_label"
            android:inputType="text"
            android:textColor="@color/text" />

        <EditText
            android:id="@+id/edit_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/key_label"
            android:inputType="textPassword"
            android:textColor="@color/text" />
    </LinearLayout>
</ScrollView>
