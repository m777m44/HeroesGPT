<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HEROES GPT ⚔ ARENA"
            android:textColor="@color/gold"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <Button
            android:id="@+id/header_github"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="12sp"
            android:textColor="@color/accent2"
            android:background="@drawable/bg_chip"
            android:text="@string/header_github" />

        <Button
            android:id="@+id/header_team"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="12sp"
            android:textColor="@color/text"
            android:background="@drawable/bg_chip"
            android:text="@string/team" />

        <Button
            android:id="@+id/header_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="12sp"
            android:textColor="@color/gold"
            android:background="@drawable/bg_chip"
            android:text="@string/update_center_short" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <Button
            android:id="@+id/tab_mission"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:textSize="12sp"
            android:textColor="@color/gold"
            android:textAllCaps="false"
            android:background="@drawable/bg_tab_selected"
            android:text="@string/tab_team" />

<Button
            android:id="@+id/tab_battle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:textSize="13sp"
            android:textColor="@color/gold"
            android:textAllCaps="false"
            android:background="@drawable/bg_tab_selected"
            android:text="@string/tab_battle" />

        <Button
            android:id="@+id/tab_chat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:textSize="13sp"
            android:textColor="@color/text_dim"
            android:textAllCaps="false"
            android:background="@drawable/bg_chip"
            android:text="@string/tab_direct" />

        <Button
            android:id="@+id/tab_ranks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="@color/text_dim"
            android:textAllCaps="false"
            android:background="@drawable/bg_chip"
            android:text="@string/tab_ranks" />
    </LinearLayout>

    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/mission_hero_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/team"
                    style="@style/SectionTitle"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/mission_team_show"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:maxLines="4"
                    android:padding="12dp"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/mission_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input"
                    android:gravity="top"
                    android:hint="@string/goal_hint"
                    android:textColorHint="@color/text_dim"
                    android:textColor="@color/text"
                    android:minHeight="110dp"
                    android:padding="14dp"
                    android:lineSpacingMultiplier="1.2"
                    android:inputType="textMultiLine|textCapSentences" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/m_tpl_biz"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:textSize="11sp"
                        android:textColor="@color/text_dim"
                        android:background="@drawable/bg_chip"
                        android:text="@string/tpl_biz" />

                    <Button
                        android:id="@+id/m_tpl_learn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="11sp"
                        android:textColor="@color/text_dim"
                        android:background="@drawable/bg_chip"
                        android:text="@string/tpl_learn" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/m_tpl_app"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:textSize="11sp"
                        android:textColor="@color/text_dim"
                        android:background="@drawable/bg_chip"
                        android:text="@string/tpl_app" />

                    <Button
                        android:id="@+id/m_tpl_content"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="11sp"
                        android:textColor="@color/text_dim"
                        android:background="@drawable/bg_chip"
                        android:text="@string/tpl_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/mission_mode_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/mode_title"
                    style="@style/SectionTitle"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/mode_fast"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:textSize="12sp"
                        android:textColor="@color/text"
                        android:background="@drawable/bg_pill"
                        android:text="@string/mode_fast" />

                    <Button
                        android:id="@+id/mode_balanced"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="12sp"
                        android:textColor="@color/text"
                        android:background="@drawable/bg_pill"
                        android:text="@string/mode_balanced" />

                    <Button
                        android:id="@+id/mode_deep"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:textSize="12sp"
                        android:textColor="@color/text"
                        android:background="@drawable/bg_pill"
                        android:text="@string/mode_deep" />
                </LinearLayout>

                <Button
                    android:id="@+id/mission_launch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_glow_button"
                    android:text="@string/launch" />

                <TextView
                    android:id="@+id/mission_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:padding="14dp"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp"
                    android:text="@string/mission_status_none" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/battle_name_a"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingBottom="6dp"
                        android:text="@string/model_a"
                        android:textColor="@color/gold"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fillViewport="true">

                        <TextView
                            android:id="@+id/battle_out_a"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text"
                            android:textSize="13sp"
                            android:lineSpacingMultiplier="1.25"
                            android:text="@string/empty_chat" />
                    </ScrollView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/battle_name_b"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingBottom="6dp"
                        android:text="@string/model_b"
                        android:textColor="@color/gold"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fillViewport="true">

                        <TextView
                            android:id="@+id/battle_out_b"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text"
                            android:textSize="13sp"
                            android:lineSpacingMultiplier="1.25"
                            android:text="@string/empty_chat" />
                    </ScrollView>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/vote_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/vote_a"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_glow_button"
                    android:text="@string/vote_a" />

                    <Button
                        android:id="@+id/vote_tie"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:textSize="11sp"
                    android:textColor="@color/text"
                    android:background="@drawable/bg_chip"
                    android:text="@string/vote_tie" />

                    <Button
                        android:id="@+id/vote_bad"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:textSize="11sp"
                    android:textColor="@color/text"
                    android:background="@drawable/bg_chip"
                    android:text="@string/vote_bad" />

                    <Button
                        android:id="@+id/vote_b"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_glow_button"
                    android:text="@string/vote_b" />
            </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <Button
                        android:id="@+id/vote_judge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:textSize="11sp"
                        android:textColor="@color/text"
                        android:background="@drawable/bg_chip"
                        android:text="@string/auto_judge" />

                    <Button
                        android:id="@+id/battle_share"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="11sp"
                        android:textColor="@color/text"
                        android:background="@drawable/bg_chip"
                        android:text="@string/share" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/new_battle_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_glow_button"
                android:text="@string/new_battle"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="10dp">

                <EditText
                    android:id="@+id/battle_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="14dp"
                    android:hint="@string/arena_hint"
                    android:textColorHint="@color/text_dim"
                    android:textColor="@color/text"
                    android:maxLines="4"
                    android:background="@drawable/bg_input"
                    android:inputType="textMultiLine|textCapSentences" />

                <ImageButton
                    android:id="@+id/battle_go"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_glow_button"
                    android:padding="14dp"
                    android:src="@drawable/ic_send"
                    android:contentDescription="@string/arena_go" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                                android:id="@+id/direct_pick"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:textSize="13sp"
                                android:textColor="@color/gold"
                                android:background="@drawable/bg_chip"
                                android:text="@string/chat_pick_hero" />

                <Button
                                android:id="@+id/direct_save"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textSize="13sp"
                                android:textColor="@color/text"
                                android:background="@drawable/bg_chip"
                                android:text="@string/save_chat" />
            </LinearLayout>

            <TextView
                android:id="@+id/direct_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="6dp"
                android:text="@string/tab_direct"
                android:textColor="@color/gold"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/direct_out"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:background="@drawable/bg_card"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/empty_chat" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="10dp">

                <EditText
                    android:id="@+id/direct_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="14dp"
                    android:hint="@string/chat_hint"
                    android:textColorHint="@color/text_dim"
                    android:textColor="@color/text"
                    android:maxLines="4"
                    android:background="@drawable/bg_input"
                    android:inputType="textMultiLine|textCapSentences" />

                <ImageButton
                    android:id="@+id/direct_send"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_glow_button"
                    android:padding="14dp"
                    android:src="@drawable/ic_send"
                    android:contentDescription="@string/chat_send" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="8dp"
                android:text="@string/ranks_subtitle"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <ListView
                android:id="@+id/ranks_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:clipToPadding="false"
                android:paddingBottom="12dp"
                android:scrollbars="none" />
        </LinearLayout>
    </ViewFlipper>
    <LinearLayout
        android:id="@+id/update_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/banner_msg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/gold"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/banner_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/banner_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_glow_button"
            android:text="@string/banner_btn_update" />

        <Button
            android:id="@+id/banner_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="13sp"
            android:textColor="@color/text_dim"
            android:background="@drawable/bg_chip"
            android:text="@string/banner_btn_close" />
    </LinearLayout>
</LinearLayout>