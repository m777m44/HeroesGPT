<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_devil_aura"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/con_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:shadowColor="#99D77757"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="22"
            android:text="HEROESGPT ⚡"
            android:textColor="@color/accent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/con_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="@string/console_subtitle"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/con_heroes"
                    style="@style/ChipStyle"
                    android:background="@drawable/bg_pill_on"
                    android:text="@string/heroes_all"
                    android:textColor="@color/accent"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/con_keys"
                    style="@style/ChipStyle"
                    android:text="@string/tool_keys" />

                <TextView
                    android:id="@+id/con_github"
                    style="@style/ChipStyle"
                    android:text="@string/tool_github" />

                <TextView
                    android:id="@+id/con_search"
                    style="@style/ChipStyle"
                    android:text="@string/tool_search" />

                <TextView
                    android:id="@+id/con_settings"
                    style="@style/ChipStyle"
                    android:text="@string/tool_settings" />

                <TextView
                    android:id="@+id/con_update"
                    style="@style/ChipStyle"
                    android:text="@string/tool_update" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <ListView
        android:id="@+id/con_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:padding="12dp"
        android:scrollbars="none"
        android:stackFromBottom="true"
        android:transcriptMode="alwaysScroll" />

    <com.heroes.gpt.ThinkingView
        android:id="@+id/con_thinking"
        android:layout_width="wrap_content"
        android:layout_height="72dp"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <EditText
            android:id="@+id/con_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:hint="@string/console_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="5"
            android:padding="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim" />

        <Button
            android:id="@+id/con_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_glow_button"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/console_send"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/con_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_card"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/con_stop"
            android:textColor="@color/danger"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
