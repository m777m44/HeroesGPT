<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/gh_title"
            android:textColor="@color/gold"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/gh_login_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gh_login_hint"
                android:textColor="@color/text_dim"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.4" />

            <EditText
                android:id="@+id/gh_token_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:hint="@string/gh_token_hint"
                android:textColorHint="@color/text_dim"
                android:textColor="@color/text"
                android:fontFamily="monospace"
                android:inputType="textPassword"
                android:maxLines="3"
                android:padding="12dp" />

            <Button
                android:id="@+id/gh_open_config"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="12sp"
                android:textColor="@color/gold"
                android:background="@drawable/bg_chip"
                android:text="@string/gh_open_config" />

            <Button
                android:id="@+id/gh_login_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="12dp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_glow_button"
                android:text="@string/gh_login" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/gh_account_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/gh_whoami"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ok"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gh_repo_show"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <Button
                android:id="@+id/gh_logout_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="12sp"
                android:textColor="@color/danger"
                android:background="@drawable/bg_chip"
                android:text="@string/gh_logout" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/gh_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gh_actions_title"
                android:textColor="@color/gold"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <Button
                android:id="@+id/gh_pick_repo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text"
                android:background="@drawable/bg_pill"
                android:text="@string/gh_pick_repo" />

            <Button
                android:id="@+id/gh_new_repo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text"
                android:background="@drawable/bg_pill"
                android:text="@string/gh_new_repo" />

            <Button
                android:id="@+id/gh_browse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text"
                android:background="@drawable/bg_pill"
                android:text="@string/gh_browse" />

            <Button
                android:id="@+id/gh_push_last"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text"
                android:background="@drawable/bg_pill"
                android:text="@string/gh_push_last" />

            <Button
                android:id="@+id/gh_upload_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text"
                android:background="@drawable/bg_pill"
                android:text="@string/gh_upload_files" />

            <Button
                android:id="@+id/gh_upload_folder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text"
                android:background="@drawable/bg_pill"
                android:text="@string/gh_upload_folder" />

            <Button
                android:id="@+id/gh_build"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_glow_button"
                android:text="@string/gh_build" />

            <Button
                android:id="@+id/gh_open_web"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="12sp"
                android:textColor="@color/gold"
                android:background="@drawable/bg_chip"
                android:text="@string/gh_open_web" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
