<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:text="HEROES"
            android:textColor="@color/gold"
            android:textSize="42sp"
            android:textStyle="bold"
            android:letterSpacing="0.3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="⚡ GPT ⚡"
            android:textColor="@color/accent"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:text="@string/tagline"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/section_command"
            android:textColor="@color/gold"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/team"
                android:textColor="@color/gold"
                android:onClick="onTeam"
                android:background="@drawable/bg_chip" />

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/providers"
                android:textColor="@color/gold"
                android:onClick="onProviders"
                android:background="@drawable/bg_chip" />

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/projects"
                android:textColor="@color/gold"
                android:onClick="onProjects"
                android:background="@drawable/bg_chip" />
        </LinearLayout>

        <EditText
            android:id="@+id/goal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="120dp"
            android:gravity="top"
            android:padding="16dp"
            android:hint="@string/goal_hint"
            android:textColorHint="@color/text_dim"
            android:textColor="@color/text"
            android:background="@drawable/bg_card"
            android:inputType="textMultiLine|textCapSentences" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:text="@string/launch"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#1A1206"
            android:onClick="onLaunch"
            android:background="@drawable/bg_glow_button" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/section_templates"
            android:textColor="@color/gold"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:textSize="12sp"
                android:textColor="@color/text"
                android:background="@drawable/bg_card"
                android:onClick="onTemplateBiz"
                android:text="@string/tpl_biz" />

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textColor="@color/text"
                android:background="@drawable/bg_card"
                android:onClick="onTemplateLearn"
                android:text="@string/tpl_learn" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:textSize="12sp"
                android:textColor="@color/text"
                android:background="@drawable/bg_card"
                android:onClick="onTemplateApp"
                android:text="@string/tpl_app" />

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textColor="@color/text"
                android:background="@drawable/bg_card"
                android:onClick="onTemplateContent"
                android:text="@string/tpl_content" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/section_hero_power"
            android:textColor="@color/gold"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/library"
                android:textColor="@color/text"
                android:onClick="onLibrary"
                android:background="@drawable/bg_card" />

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/arena"
                android:textColor="@color/text"
                android:onClick="onArena"
                android:background="@drawable/bg_card" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/chat"
                android:textColor="@color/text"
                android:onClick="onChat"
                android:background="@drawable/bg_card" />

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/update_center_short"
                android:textColor="@color/gold"
                android:onClick="onUpdate"
                android:background="@drawable/bg_card" />
        </LinearLayout>

        <TextView
            android:id="@+id/runs_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:padding="16dp"
            android:background="@drawable/bg_card"
            android:text="@string/majestic_welcome"
            android:textColor="@color/text_dim"
            android:textSize="14sp"
            android:onClick="onLatestRun" />
    </LinearLayout>
</ScrollView>
