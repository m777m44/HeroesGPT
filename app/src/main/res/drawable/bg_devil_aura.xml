<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#141024"
                android:centerColor="#0B0A14"
                android:endColor="#07070B"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#339D4EDD" />
            <corners android:radius="0dp" />
        </shape>
    </item>
</layer-list>
