<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_app"
        android:theme="@style/AppTheme"
        android:allowBackup="true"
        android:supportsRtl="true">

        <activity
            android:name=".ArenaHomeActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".CockpitActivity" android:exported="false" />
        <activity android:name=".RunActivity" android:exported="false" />
        <activity android:name=".TeamActivity" android:exported="false" />
        <activity android:name=".ProvidersActivity" android:exported="false" />
        <activity android:name=".ProjectsActivity" android:exported="false" />
        <activity android:name=".LibraryActivity" android:exported="false" />
        <activity android:name=".ArenaActivity" android:exported="false" />
        <activity android:name=".ChatActivity" android:exported="false" />
        <activity android:name=".UpdateActivity" android:exported="false" />
        <activity android:name=".LockActivity" android:exported="false" />
        <activity android:name=".StatsActivity" android:exported="false" />
        <activity android:name=".ChatsActivity" android:exported="false" />
        <activity android:name=".GithubActivity" android:exported="false" />
        <activity android:name=".SourcesActivity" android:exported="false" />
        <activity android:name=".SourcePanelActivity" android:exported="false" />

        <provider
            android:name=".ApkProvider"
            android:authorities="com.heroes.gpt.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
