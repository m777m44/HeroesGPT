{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phonecall",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "CALL_JOB", "class_name": "CallJob" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CallJob", "Registry"] }]
  // All configuration is stored as Worker secrets by `npm run setup`. See README.md.
}
