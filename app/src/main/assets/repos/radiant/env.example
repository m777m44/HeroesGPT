# PlanetScale MySQL (primary read/write + read-only reader role)
DATABASE_URL=mysql://user:pass@aws.connect.psdb.cloud/radiant?ssl={"rejectUnauthorized":true}
DATABASE_READ_URL=mysql://reader:pass@aws.connect.psdb.cloud/radiant?ssl={"rejectUnauthorized":true}

# account.anoma.ly OIDC
ACCOUNT_ISSUER=https://account.dev.anoma.ly
ACCOUNT_CLIENT_ID=radiant

# Encryption & signing (32-byte base64 keys)
ENCRYPTION_KEY=replace-with-32-byte-base64-key
ENCRYPTION_KEY_VERSION=v1
SESSION_SECRET=replace-with-32-byte-base64-key

# Plaid (sandbox | production)
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
